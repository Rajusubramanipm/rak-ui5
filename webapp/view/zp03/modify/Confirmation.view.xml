<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:rak="rak.services.control"
    controllerName="rak.services.controller.zp03.modify.Confirmation"
    displayBlock="true">

    <Page id="zp03ConfirmationPage" showHeader="false" class="zp03Page">
        <content>
            <VBox class="zp03PlaceholderCard">
                <rak:RakStepper
                    activeStep="{view>/activeStep}"
                    stepLabels="{view>/stepLabels}" />
                <Title text="ZP03 — Modify Infrastructure NOC" level="H2" titleStyle="H3" class="sapUiSmallMarginTop" />
                <Title text="Confirmation (placeholder)" level="H3" titleStyle="H4" class="sapUiTinyMarginTop" />
                <Text
                    text="Foundation placeholder only. Full Figma UI and BRD rules will be implemented after structure review."
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                <HBox>
                    <Button text="Back" type="Transparent" press=".onBack" />
                    <Button text="Back to Home" type="Emphasized" press=".onHome" class="sapUiTinyMarginBegin" />
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
